{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@Terminal/*": [
        "./src/Terminal/*"
      ],
      "@Routes/*": [
        "./src/Routes/*"
      ],
      "@Schema/*": [
        "./src/Schema/*"
      ],
      "@drizzle/*": [
        "./src/drizzle/*"
      ],
      "@Workshop/*": [
        "./src/Workshop/*"
      ],
      "@Toolkits/*": [
        "./src/Toolkit/*"
      ],
      "@Types/*": [
        "./src/Types/*"
      ],
      "@CheckPoint/*": [
        "./src/CheckPoint/*"
      ],
      "@Operator/*": [
        "./src/Operator/*"
      ]
    },
    "sourceMap": true,
    "strict": true,
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*"
  ]
}