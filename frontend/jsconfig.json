{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@assets/*": [
                "./src/assets/*"
            ],
            "@pages/*": [
                "./src/pages/*"
            ],
            "@api/*": [
                "./src/api/*"
            ],
            "@styles/*": [
                "./src/styles/*"
            ],
            "@schemas/*": [
                "./src/schemas/*"
            ],
            "@store/*": [
                "./src/store/*"
            ],
            "@services/*": [
                "./src/services/*"
            ]
        }
    },
    "include": [
        "src"
    ]
}