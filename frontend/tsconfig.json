{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        /* Modern paths mapping without baseUrl */
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@assets/*": [
                "./src/assets/*"
            ],
            "@pages/*": [
                "./src/pages/*"
            ],
            "@api/*": [
                "./src/api/*"
            ],
            "@styles/*": [
                "./src/styles/*"
            ],
            "@schemas/*": [
                "./src/schemas/*"
            ],
            "@store/*": [
                "./src/store/*"
            ],
            "@services/*": [
                "./src/services/*"
            ],
            "@hooks/*": [
                "./src/hooks/*"
            ],
            "@shared/*": [
                "../shared/*"
            ]
        }
    },
    "include": [
        "src"
    ]
}